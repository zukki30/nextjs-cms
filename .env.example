# =============================================================================
# nextjs-cms 環境変数テンプレート
# docs/specs/github-content-cms/design.md 13章 に対応
#
# このファイルは Git で追跡される。値は絶対に書かないこと。
# 実際の値は .env に書く（.gitignore 済み）。
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub OAuth App — ユーザーの本人確認のみに使う（0-2）
# 書き込み権限は持たない。アクセストークンは許可判定後に破棄する。
# -----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# -----------------------------------------------------------------------------
# Admin 許可リスト — 既定は拒否。空なら誰もログインできない
# LOGINS はカンマ区切り。ORG / ORG_TEAM は任意
# -----------------------------------------------------------------------------
ADMIN_ALLOWED_LOGINS=
ADMIN_ALLOWED_ORG=
ADMIN_ALLOWED_ORG_TEAM=

# -----------------------------------------------------------------------------
# GitHub App — content リポジトリへの commit / PR に使う（0-3 / 0-4）
# PRIVATE_KEY は .pem を Base64 エンコードした1行文字列を推奨
#   base64 -i ~/Downloads/xxx.private-key.pem | tr -d '\n'
# PEM のまま（改行を \n にエスケープした形式）でも読み込める
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# -----------------------------------------------------------------------------
# content リポジトリ（0-1）
# -----------------------------------------------------------------------------
CONTENT_REPO_OWNER=
CONTENT_REPO_NAME=
CONTENT_REPO_BRANCH=main

# -----------------------------------------------------------------------------
# Webhook — Phase 5 で GitHub App 側に同じ値を設定する
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# ImageKit（0-5）
# PRIVATE_KEY は Restricted key の private 値。NEXT_PUBLIC_ を付けないこと
# public key と URL endpoint は公開前提の値なので NEXT_PUBLIC_ のみ定義する
# FOLDER_PREFIX は任意。1アカウントを複数プロジェクトで共有する場合に設定
# -----------------------------------------------------------------------------
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER_PREFIX=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# -----------------------------------------------------------------------------
# 公開 API — CORS 許可オリジン。カンマ区切り。* で全許可
# -----------------------------------------------------------------------------
PUBLIC_API_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# レート制限 — Phase 15 で使用。管理 API と Webhook のみに適用する（0-6）
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# 実表示プレビュー — Phase 17（公開サイト構築時）に追加する。design.md 5.7.2
# 必要になるまでは未定義のままでよい
# -----------------------------------------------------------------------------
# PREVIEW_TOKEN_SECRET=
# PUBLIC_SITE_PREVIEW_URL=
